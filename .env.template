# Spring profile: dev or prod
SPRING_PROFILES_ACTIVE=dev

# JWT settings
# Use a long random string in real environments
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_EXPIRATION=600000

# PostgreSQL credentials
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=library_db

# Full JDBC URL for prod profile
# Example:
# jdbc:postgresql://host:5432/library_db?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/library_db